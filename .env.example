# ==========================================
# CONFIGURACION DE ENTORNO - SISTEMA LOGISTICO IOT
# ==========================================

# Credenciales de Mailtrap (SMTP o API Key)
MAILTRAP_API_KEY=your_mailtrap_api_key_here
MAILTRAP_USERNAME=your_mailtrap_smtp_username
MAILTRAP_PASSWORD=your_mailtrap_smtp_password
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_SENDER_EMAIL=logistica-ai@empresa.com
ALERT_RECIPIENT_EMAIL=gerente-inventarios@empresa.com

# Direccion IP del Microcontrolador ESP32 Gateway
ESP32_IP=192.168.1.150
ESP32_PORT=80

# Politica de Resiliencia de Telemetria
MAX_SENSOR_RETRIES=3
SENSOR_TIMEOUT_SECONDS=3.0
POLLING_INTERVAL_SECONDS=10

# Persistencia MCP & Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Capacidad Maxima de Produccion por Orden (Filtro Bullwhip)
MAX_PRODUCTION_CAPACITY=200

# Integracion Polar.sh (Monetizacion, Catalogo y Checkout)
POLAR_ACCESS_TOKEN=polar_oat_your_access_token_here
POLAR_ORGANIZATION_ID=your_polar_organization_id_here
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here

# Integracion Stellar Network (Smart Wallets IoT & Pagos por Contacto)
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_AUTO_FUND_TESTNET=true
STELLAR_OPERATOR_SECRET_KEY=S...your_operator_stellar_secret_seed
STELLAR_OPERATOR_PUBLIC_KEY=G...your_operator_stellar_public_key

