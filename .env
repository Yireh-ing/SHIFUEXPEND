# Credenciales de Mailtrap (Modo seguro / Simulación local)
MAILTRAP_API_KEY=mock_dev_key_2026
MAILTRAP_USERNAME=mock_user
MAILTRAP_PASSWORD=mock_pass
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_SENDER_EMAIL=logistica-ai@empresa.com
ALERT_RECIPIENT_EMAIL=gerente-inventarios@empresa.com

# Direccion IP del Microcontrolador ESP32 Gateway (Local mock / IP real)
ESP32_IP=127.0.0.1
ESP32_PORT=8000

# Politica de Resiliencia de Telemetria
MAX_SENSOR_RETRIES=3
SENSOR_TIMEOUT_SECONDS=3.0
POLLING_INTERVAL_SECONDS=15

# Persistencia MCP & Supabase
SUPABASE_URL=https://mock.supabase.co
SUPABASE_KEY=mock_supabase_token

# Capacidad Maxima de Produccion por Orden (Filtro Bullwhip)
MAX_PRODUCTION_CAPACITY=200

# Integracion Polar.sh (Monetizacion, Catalogo y Checkout)
POLAR_ACCESS_TOKEN=polar_oat_mock_token_dev
POLAR_ORGANIZATION_ID=
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=

# Integracion Stellar Network (Smart Wallets IoT & Pagos por Contacto)
